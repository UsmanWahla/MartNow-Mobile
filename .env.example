EXPO_PUBLIC_API_URL=http://YOUR_COMPUTER_LAN_IP:5000

# Production EAS environment must use HTTPS, for example:
# EXPO_PUBLIC_API_URL=https://api.example.com

# Required only for Android standalone/development builds that render Google Maps.
# Restrict this key to your Android package name and signing certificate SHA-1.
GOOGLE_MAPS_ANDROID_API_KEY=

# Development only. Keep unset/false in production and use an HTTPS API URL.
MARTNOW_ALLOW_HTTP=true
