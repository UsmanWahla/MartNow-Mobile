{
  "expo": {
    "name": "MartNow Mobile",
    "slug": "martnow-mobile",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/martnow-app-icon.png",
    "scheme": "martnow",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/images/martnow-app-icon.png",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        }
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B1F1C",
        "foregroundImage": "./assets/images/martnow-app-icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/martnow-app-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B1F1C",
          "image": "./assets/images/martnow-app-icon.png",
          "imageWidth": 128
        }
      ],
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow MartNow to use your location when selecting a delivery address."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
