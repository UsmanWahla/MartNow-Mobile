{
  "expo": {
    "name": "MartNow",
    "slug": "martnow-mobile",
    "version": "1.0.0",
    "platforms": ["ios", "android"],
    "orientation": "default",
    "icon": "./assets/images/martnow-app-icon.png",
    "scheme": "martnow",
    "userInterfaceStyle": "light",
    "backgroundColor": "#EEF6F3",
    "androidStatusBar": {
      "barStyle": "dark-content",
      "backgroundColor": "#EEF6F3",
      "hidden": false
    },
    "ios": {
      "icon": "./assets/images/martnow-app-icon.png",
      "bundleIdentifier": "com.martnow.mobile",
      "buildNumber": "1"
    },
    "android": {
      "package": "com.martnow.mobile",
      "versionCode": 1,
      "backgroundColor": "#EEF6F3",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/martnow-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/martnow-logo.png",
          "imageWidth": 280
        }
      ],
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow MartNow to use your location when selecting a delivery address."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "1df53c77-c52e-4b53-b0da-629e7b5c41f2"
      }
    }
  }
}
